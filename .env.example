# Paper is the default. LIVE_MODE=true is ignored unless PAPER_MODE=false,
# and even then the bot will not post a CLOB order. Live submission is a
# separate code latch in live_order_preflight.py and is intentionally false.
PAPER_MODE=true
LIVE_MODE=false
AI_OFFLINE=1

# Research keys. Leave blank to stay on the deterministic offline path.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_API_KEY=
ARENA_MODELS=openai/gpt-4.1-mini,google/gemini-2.5-flash

# Risk. MAX_DAILY_DRAWDOWN is a USDC daily loss stop.
MIN_CONSENSUS_SCORE=0.67
MIN_EDGE_BPS=100
MIN_CONFIDENCE=0.55
KELLY_FRACTION=0.25
MAX_POSITION_USDC=2
MAX_DAILY_DRAWDOWN=5
MAX_MARKETS=5

# Existing paper engine knobs still apply to app.py.
PAPER_STARTING_CASH=100
PAPER_MAX_OPEN_EXPOSURE_USD=10
PAPER_MAX_OPEN_POSITIONS=5
DATA_DIR=data

# Read only if PAPER_MODE=false and LIVE_MODE=true. Never commit a real key.
# Live posting still will not run until the repository latch is changed.
POLYMARKET_PRIVATE_KEY=
LIVE_TRADING_ACK=
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_CHAIN_ID=137
