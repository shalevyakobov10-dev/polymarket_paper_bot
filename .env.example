# Offline research / paper mode only. No Polymarket API, wallet, or order keys.
DRY_RUN=true
LIVE_EXECUTION_ENABLED=false

# Public market data source. live_clob uses Gamma metadata + read-only CLOB books.
# Set local_json to replay a manually prepared historical snapshot file.
PAPER_MARKET_DATA_SOURCE=live_clob
PAPER_LIVE_MARKETS_LIMIT=10
PAPER_GAMMA_PAGE_SIZE=100

# Local market snapshot/replay file (used only when PAPER_MARKET_DATA_SOURCE=local_json).
MARKET_SNAPSHOT_FILE=./data/market_snapshots.json
MARKET_SNAPSHOT_MAX_AGE_SECONDS=180

# News feeds are third-party RSS sources, not Polymarket services.
NEWS_LOG_PATH=./data/offline_news_events.jsonl
PAPER_POLL_SECONDS=300
NEWS_MAXIMUM_AGE_HOURS=24
NEWS_SENTIMENT_HALF_LIFE_HOURS=6
PAPER_EVENT_EVIDENCE_THRESHOLD=0.75
NEWS_MINIMUM_PUBLISHERS=2
PAPER_MIN_EVENT_CONSENSUS_RATIO=0.75

# Paper portfolio and hard risk limits.
PAPER_DATABASE_PATH=./data/offline_news_paper.sqlite3
PAPER_STARTING_CASH=100
PAPER_MAX_POSITION_USD=5
PAPER_MAX_OPEN_EXPOSURE_USD=20
PAPER_MAX_OPEN_POSITIONS=5
PAPER_RISK_PER_TRADE_PCT=0.01
PAPER_MAX_DAILY_DRAWDOWN_PCT=0.05
PAPER_MAX_PORTFOLIO_DRAWDOWN_PCT=0.20
PAPER_FEE_RATE=0.01
PAPER_MAX_SPREAD_BPS=500
PAPER_MAX_HOLD_HOURS=24

# Volatility-aware exits. Prices and stop distances are probability points (0..1).
PAPER_FALLBACK_VOLATILITY=0.02
PAPER_STOP_VOLATILITY_MULTIPLIER=2
PAPER_TAKE_PROFIT_R_MULTIPLE=2
PAPER_MINIMUM_STOP_DISTANCE=0.02
PAPER_MAXIMUM_STOP_DISTANCE=0.15

# Self-learning is paper-only, requires a chronological holdout and at least 60
# closed paper trades. It can only tighten the sentiment threshold.
PAPER_AUTO_TUNE_ENABLED=true
PAPER_AUTO_TUNE_MINIMUM_TRADES=60
PAPER_AUTO_TUNE_INTERVAL_HOURS=24

# Optional: Python-dotenv reads this file when running the script.
# Real order adapter. Disabled by default; never commit actual secrets.
# Live FAK BUY execution requires ALL runtime/release gates and geoblock checks.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ARMED=false
LIVE_TRADING_CONFIRMATION=
LIVE_EXPECTED_WALLET=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_DEPOSIT_WALLET=
LIVE_MAX_ORDER_NOTIONAL_USD=5
LIVE_MAX_OPEN_POSITIONS=3
LIVE_MAX_OPEN_EXPOSURE_USD=20
LIVE_DAILY_LOSS_LIMIT_USD=5
LIVE_MAX_DRAWDOWN_PCT=5
LIVE_MAX_PRICE_IMPACT_BPS=100
LIVE_MAX_BOOK_AGE_SECONDS=3
LIVE_RISK_CONTEXT_MAX_AGE_SECONDS=30
