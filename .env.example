# Offline research / paper mode only. No Polymarket API, wallet, or order keys.
DRY_RUN=true
LIVE_EXECUTION_ENABLED=false

# Continuous event-aware paper research worker (no order submission).
ENABLE_EVENT_PAPER_WORKER=true
EVENT_PAPER_WORKER_STATUS_FILE=./data/event_paper_worker_status.json

# Public Polymarket perpetual-contract market data only. No auth or order access.
ENABLE_PERPS_MARKET_DATA_WORKER=true
PERPS_MARKET_HISTORY_DB=./data/perps_market_history.sqlite3
PERPS_ORDER_JOURNAL_DB=./data/perps_order_journal.sqlite3
PERPS_MARKET_WORKER_STATUS_FILE=./data/perps_market_worker_status.json
# Status target for a separately injected read-only Perps account supervisor.
PERPS_ACCOUNT_SUPERVISOR_STATUS_FILE=./data/perps_account_supervisor_status.json
# The authenticated read-only Perps account worker is separately opt-in and disabled by default.
# Mount this JSON file from the deployment secret manager; never commit it.
# It contains existing owner/API/delegated-Perps credentials and must be mode 0400 or 0600.
# Application-only read allowlist; SDK delegated credentials may still sign writes.
# Keep disabled in the shared app container: its children share the same Linux UID.
# Use a separately isolated account-observer service before mounting real credentials.
ENABLE_PERPS_ACCOUNT_SUPERVISOR=false
PERPS_ACCOUNT_SUPERVISOR_SECRETS_FILE=
PERPS_SUBMISSION_LOCK_PATH=./data/perps_submission.lock
PERPS_ACCOUNT_SUPERVISOR_POLL_SECONDS=30
PERPS_ACCOUNT_SUPERVISOR_CYCLE_TIMEOUT_SECONDS=60
PERPS_ACCOUNT_SUPERVISOR_MAX_FAILURES=10
# Must cover poll cadence plus account-preflight cycle time; PID 1 validates the minimum.
PERPS_ACCOUNT_SUPERVISOR_HEARTBEAT_TIMEOUT_SECONDS=180
PERPS_MARKET_LIMIT=10
PERPS_BACKUP_DIRECTORY=./data/perps_backups
PERPS_BACKUP_INTERVAL_HOURS=6
PERPS_BACKUP_RETAIN=30
PERPS_WORKER_MAX_CONSECUTIVE_FAILURES=10
# Watchdog includes PERPS_MARKET_LIMIT plus up to 10 prioritized open positions.
PERPS_WORKER_HEARTBEAT_TIMEOUT_SECONDS=330
PERPS_POLL_INTERVAL_SECONDS=30
PERPS_HISTORY_RETENTION_DAYS=14

# Isolated-margin Perps PAPER engine. Simulated capital only; no wallet/orders.
# Future Perps live execution remains hard-blocked by perps_live_release_gate.py.
PERPS_LIVE_EXECUTION_ENABLED=false
PERPS_LIVE_TRADING_ARMED=false
PERPS_LIVE_CONFIRMATION=
ENABLE_PERPS_PAPER_ENGINE=true
PERPS_PAPER_DB=./data/perps_paper.sqlite3
PERPS_PAPER_INITIAL_EQUITY=1000
PERPS_PAPER_MAX_POSITION_NOTIONAL=25
PERPS_PAPER_MAX_TOTAL_NOTIONAL=75
PERPS_PAPER_MAX_OPEN_POSITIONS=3
PERPS_PAPER_MAX_LEVERAGE=2
PERPS_PAPER_RISK_PER_TRADE_PCT=0.0025
PERPS_PAPER_STOP_LOSS_PCT=0.0075
PERPS_PAPER_TAKE_PROFIT_PCT=0.015
# Only applied to legacy paper positions when migrating databases created by older versions.
# New entries use the latest public Perps fee schedule; liquidation fees use instrument metadata.
PERPS_PAPER_LEGACY_TAKER_FEE_RATE=0.0005
PERPS_PAPER_LEGACY_LIQUIDATION_FEE_RATE=0.01
PERPS_PAPER_MAX_SPREAD_BPS=20
PERPS_PAPER_LOOKBACK_OBSERVATIONS=10
PERPS_PAPER_MOMENTUM_THRESHOLD_BPS=20
PERPS_PAPER_MIN_HISTORY_SPAN_SECONDS=270
PERPS_PAPER_DAILY_DRAWDOWN_PCT=0.03
PERPS_PAPER_MAXIMUM_DRAWDOWN_PCT=0.10
PERPS_PAPER_MAX_ENTRY_IMPACT_BPS=50
PERPS_PAPER_MAX_DATA_AGE_SECONDS=15
# Funding API schedule update grace and maximum post-settlement Mark observation delay.
PERPS_PAPER_FUNDING_SCHEDULE_GRACE_SECONDS=60
PERPS_PAPER_MAX_POST_FUNDING_MARK_DELAY_SECONDS=90

# Public market data source. live_clob uses Gamma metadata + read-only CLOB books.
# Set local_json to replay a manually prepared historical snapshot file.
PAPER_MARKET_DATA_SOURCE=live_clob
PAPER_LIVE_MARKETS_LIMIT=30
PAPER_GAMMA_PAGE_SIZE=200
PAPER_GAMMA_DISCOVERY_PAGES=3
PAPER_MARKET_CATEGORY_MAX=8
ORDERBOOK_TOKENS_PER_POLL=60

# Append-only SQLite archive of observed CLOB bid/ask and top-five book levels.
MARKET_HISTORY_DATABASE_PATH=./data/market_history.sqlite3
PAPER_BACKUP_DIRECTORY=./data/backups
PAPER_BACKUP_RETAIN=30
PAPER_BACKUP_INTERVAL_HOURS=6

# Local market snapshot/replay file (used only when PAPER_MARKET_DATA_SOURCE=local_json).
MARKET_SNAPSHOT_FILE=./data/market_snapshots.json
MARKET_SNAPSHOT_MAX_AGE_SECONDS=180

# News feeds are third-party RSS sources, not Polymarket services.
NEWS_LOG_PATH=./data/news_events.jsonl
GDELT_LOG_PATH=./data/gdelt_news.jsonl
NEWS_POLL_SECONDS=60
GDELT_TOPICS_PER_POLL=4
GDELT_TIMESPAN=1h
GDELT_MIN_REQUEST_INTERVAL_SECONDS=5
PAPER_POLL_SECONDS=60
NEWS_MAXIMUM_AGE_HOURS=24
NEWS_SENTIMENT_HALF_LIFE_HOURS=6
PAPER_EVENT_EVIDENCE_THRESHOLD=0.75
NEWS_MINIMUM_PUBLISHERS=2
PAPER_MIN_EVENT_CONSENSUS_RATIO=0.75

# Paper portfolio and hard risk limits.
PAPER_DATABASE_PATH=./data/offline_news_paper.sqlite3
PAPER_STARTING_CASH=100
PAPER_MAX_POSITION_USD=5
PAPER_MAX_OPEN_EXPOSURE_USD=20
PAPER_MAX_OPEN_POSITIONS=5
PAPER_RISK_PER_TRADE_PCT=0.01
PAPER_MAX_DAILY_DRAWDOWN_PCT=0.05
PAPER_MAX_PORTFOLIO_DRAWDOWN_PCT=0.20
PAPER_FEE_RATE=0.01
PAPER_MAX_SPREAD_BPS=500
PAPER_MAX_ENTRY_IMPACT_BPS=100
PAPER_MAX_HOLD_HOURS=24

# Volatility-aware exits. Prices and stop distances are probability points (0..1).
PAPER_FALLBACK_VOLATILITY=0.02
PAPER_STOP_VOLATILITY_MULTIPLIER=2
PAPER_TAKE_PROFIT_R_MULTIPLE=2
PAPER_MINIMUM_STOP_DISTANCE=0.02
PAPER_MAXIMUM_STOP_DISTANCE=0.15

# Self-learning is paper-only, requires a chronological holdout and at least 60
# closed paper trades. It can only tighten the event-evidence threshold.
PAPER_AUTO_TUNE_ENABLED=true
PAPER_AUTO_TUNE_MINIMUM_TRADES=60
PAPER_AUTO_TUNE_INTERVAL_HOURS=24

# Optional: Python-dotenv reads this file when running the script.
# Real order adapter. Disabled by default; never commit actual secrets.
# Live FAK BUY execution requires ALL runtime/release gates and geoblock checks.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ARMED=false
LIVE_TRADING_CONFIRMATION=
LIVE_EXPECTED_WALLET=
POLYMARKET_PRIVATE_KEY=
POLYMARKET_DEPOSIT_WALLET=
LIVE_MAX_ORDER_NOTIONAL_USD=5
LIVE_MAX_OPEN_POSITIONS=3
LIVE_MAX_OPEN_EXPOSURE_USD=20
LIVE_DAILY_LOSS_LIMIT_USD=5
LIVE_MAX_DRAWDOWN_PCT=5
LIVE_MAX_PRICE_IMPACT_BPS=100
LIVE_MAX_BOOK_AGE_SECONDS=3
LIVE_RISK_CONTEXT_MAX_AGE_SECONDS=30
# Event Live kill-switch status. Missing, malformed, stale or symlinked file blocks all live submissions.
EVENT_LIVE_KILL_SWITCH_PATH=./data/event_live_kill_switch.json
